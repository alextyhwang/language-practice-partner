# Required: server-side OpenAI key. Never expose this to the browser.
OPENAI_API_KEY=sk-proj-your-key-here

# Realtime voice-agent model used for coaching sessions.
# Use gpt-realtime-2 for the speaking coach. Use gpt-realtime-translate
# only for the dedicated translation experience (different endpoint).
OPENAI_REALTIME_MODEL=gpt-realtime-2

# Base Realtime endpoint (override only for proxies / Azure-style gateways).
OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime

# HTTP + WebSocket port for this backend.
PORT=8787

# Comma-separated list of allowed browser origins for REST + WS.
# Use "*" only for local development.
ALLOWED_ORIGINS=*

# Default coach voice (marin, cedar, alloy, ...).
DEFAULT_VOICE=marin
